# ==============================================================================
# EXEMPLE DE CONFIGURATION — placeholders uniquement
# ==============================================================================
# ⚠️ NE JAMAIS mettre de valeur réelle dans ce fichier : il est versionné.
#
# La configuration de l'application se fait désormais via --dart-define-from-file
# (voir env/dev.json.example et lib/core/config/env.dart), pas via ce fichier.
# Il est conservé à titre documentaire pour l'infrastructure.
#
# Les identifiants de connexion directe à PostgreSQL ont été retirés :
# l'application Flutter passe exclusivement par l'API Supabase. Aucun secret
# serveur (mot de passe DB, clé privée KKiaPay, clé service_role) ne doit
# se trouver dans le dépôt ni dans le binaire.
# ==============================================================================

# Supabase — https://app.supabase.com/project/<PROJECT>/settings/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# KKiaPay — seule la clé PUBLIQUE est utilisée côté application.
# La clé PRIVÉE reste côté serveur (variable d'environnement Supabase Edge Function).
KKIAPAY_PUBLIC_KEY=YOUR_KKIAPAY_PUBLIC_KEY

# OAuth
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID

# Environnement : dev | staging | prod
ENV=dev
